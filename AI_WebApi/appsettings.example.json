{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "IReGoTools": {
    "DifyServiceBearerToken": "<random-service-token>",
    "SessionRefSigningKey": "<persistent-random-signing-key-at-least-32-bytes>",
    "SnapshotTtlSeconds": 300,
    "SourceCompleteness": "authoritative_primary",
    "ReportImage": {
      "Mode": "DurableFileSystem",
      "SigningKey": "<independent-random-signing-key-at-least-32-bytes>",
      "PublicBaseUrl": "<https-report-base-url>",
      "StoragePath": "/app/data/patient-reports",
      "UrlTtlSeconds": 300,
      "CacheTtlSeconds": 600,
      "MaxImageBytes": 5242880,
      "MaxCacheBytes": 134217728,
      "TemplateVersion": "irego-single-v2",
      "LongitudinalTemplateVersion": "irego-longitudinal-v6",
      "BrowserExecutablePath": "/usr/bin/chromium",
      "RenderTimeoutSeconds": 30,
      "MaxConcurrentRenders": 2
    }
  },
  "IReTourTools": {
    "SessionRefSigningKey": "<persistent-random-signing-key-at-least-32-bytes>",
    "SourceCompleteness": "partial",
    "SingleReportTemplateVersion": "iretour-single-v3",
    "LongitudinalReportTemplateVersion": "iretour-longitudinal-v3"
  },
  "IReCogTools": {
    "SessionRefSigningKey": "<independent-persistent-random-key-at-least-32-bytes>",
    "ReportTemplateVersion": "irecog-observed-assessment-v1"
  },
  "AssessmentTools": {
    "ReferenceSigningKey": "<independent-persistent-random-key-at-least-32-bytes>",
    "ReportTemplateVersion": "assessment-records-v1"
  },
  "HospitalOperations": {
    "PublicBaseUrl": "http://192.168.8.160:5043",
    "RequestTimeoutSeconds": 15,
    "DirectoryCacheSeconds": 300,
    "ArtifactRefSigningKey": "<independent-random-signing-key-at-least-32-bytes>",
    "ArtifactStoragePath": "/app/data/hospital-operation-reports",
    "MaxArtifactBytes": 8388608,
    "AnalysisRuleVersion": "hospital-analysis-rules-v2",
    "TemplateVersion": "hospital-operations-v3",
    "RenderProfile": "html-png-v1"
  },
  "MainDB": "robotdb_main",
  "MutiDBEnabled": true,
  "DBS": [
    {
      "ConnId": "robotdb_main",
      "DBType": 0,
      "Enabled": true,
      "HitRate": 20,
      "Connection": "server=mysql8;Database=robotdb;Uid=<readonly-user>;Pwd=<password>;Port=3306;Allow User Variables=True;"
    },
    {
      "ConnId": "project_identity_temp",
      "DBType": 0,
      "Enabled": true,
      "HitRate": 20,
      "Connection": "server=mysql8;Database=project_cpoy;Uid=<readonly-user>;Pwd=<password>;Port=3306;Allow User Variables=True;"
    }
  ]
}
