# Optional: reuse a local runtime with Chromium/fonts already installed.
# Set both values together; the Dockerfile verifies the dependencies.
# AI_WEBAPI_RUNTIME_IMAGE=ai_webapi:runtime-base-<content-hash>
# AI_WEBAPI_INSTALL_RUNTIME_DEPENDENCIES=false
# AI_WEBAPI_PORT=5043
IReGoTools__DifyServiceBearerToken=<set-a-new-secret-at-deploy-time>
IReGoTools__SessionRefSigningKey=<set-a-new-secret-at-deploy-time>
IReGoTools__ReportImage__SigningKey=<set-a-new-secret-at-deploy-time>
IReGoTools__ReportImage__PublicBaseUrl=http://localhost:5043
IReGoTools__ReportImage__Mode=DurableFileSystem
IReGoTools__ReportImage__StoragePath=/app/data/patient-reports
# Hospital query upstream shared by interfaces 11-15.
HospitalOperations__UpstreamBaseUrl=http://192.168.8.71:8085/webyun
HospitalOperations__PublicBaseUrl=http://localhost:5043
HospitalOperations__RequestTimeoutSeconds=15
HospitalOperations__DirectoryCacheSeconds=300
HospitalOperations__ArtifactRefSigningKey=<set-a-new-secret-at-deploy-time>
HospitalOperations__ArtifactStoragePath=/app/data/hospital-operation-reports
HospitalOperations__AnalysisRuleVersion=hospital-analysis-rules-v2
HospitalOperations__TemplateVersion=hospital-operations-v3
HospitalOperations__RenderProfile=html-png-v1
RehabTools__DefaultSpaceId=<default-space-id>
RehabTools__Doctor__LoginUrl=<doctor-login-url>
RehabTools__Doctor__QueryUrl=<doctor-query-url>
RehabTools__Doctor__LoginPhone=<doctor-login-phone>
RehabTools__Doctor__LoginPassword=<doctor-login-password>
RehabTools__Doctor__TokenTtlMinutes=60
RehabTools__Doctor__RequestTimeoutSeconds=15
RehabTools__Scene__VersionUrl=<scene-version-url>
RehabTools__Scene__QueryUrl=<scene-query-url>
RehabTools__Scene__ApiKey=<scene-api-key>
RehabTools__Scene__ApiToken=<scene-api-token>
RehabTools__Scene__RequestTimeoutSeconds=15
RehabTools__Scene__Resolver__MinimumScore=0.75
RehabTools__Scene__Resolver__MinimumMargin=0.05
MainDB=project_main
MutiDBEnabled=true
DBS__0__ConnId=robotdb_main
DBS__0__DBType=0
DBS__0__Enabled=true
DBS__0__HitRate=100
DBS__0__Connection=server=mysql8;Database=robotdb;Uid=<readonly-user>;Pwd=<password>;Port=3306;Allow User Variables=True;
DBS__1__ConnId=project_main
DBS__1__DBType=0
DBS__1__Enabled=true
DBS__1__HitRate=100
DBS__1__Connection=server=mysql8;Database=project;Uid=<readonly-user>;Pwd=<password>;Port=3306;Allow User Variables=True;
# Patient rehabilitation contract 2.0.0. Set the signing key in the secret store.
# The authenticated business backend issues patient_identity_v2 proofs with this key.
PatientAccess__IdentitySigningKey=
PatientAccess__MaximumProofLifetimeSeconds=900
# Keep false until the dbwalk.userId source namespace is verified.
PatientAccess__WalkUserIdsUseProjectNamespace=false
